# MyGoProfile environment variables
# Copy to .env and fill in values. Never commit .env.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:9002
# Your admin account email (gets enterprise access). Also set NEXT_PUBLIC_ADMIN_EMAIL for client UI.
ADMIN_EMAIL=you@example.com
NEXT_PUBLIC_ADMIN_EMAIL=you@example.com

# --- Supabase (Auth + Postgres) ---
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Google Cloud project: mgp-cloud ---
# Used ONLY for Google Business Profile OAuth + APIs (not app auth)
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI on the OAuth client
GOOGLE_REDIRECT_URI=http://localhost:9002/api/google/callback
# 32+ byte random secret for encrypting Google refresh tokens at rest
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- Stripe TEST mode (switch to live keys only when ready) ---
# Dashboard → Developers → API keys (toggle Test mode ON)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# stripe listen --forward-to localhost:9002/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
# Products → Prices (run: node scripts/setup-stripe-prices.mjs)
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_GROWTH_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...
STRIPE_STARTER_ANNUAL_PRICE_ID=price_...
STRIPE_GROWTH_ANNUAL_PRICE_ID=price_...
STRIPE_ENTERPRISE_ANNUAL_PRICE_ID=price_...

# --- AI (Google AI / Gemini via Genkit) ---
GEMINI_API_KEY=

# --- Email ---
RESEND_API_KEY=re_...
EMAIL_FROM=MyGoProfile <hello@mygoprofile.com>
ADMIN_NOTIFY_EMAIL=you@example.com

# --- Google Business Profile real-time notifications (optional MVP) ---
# 1) Enable "My Business Notifications API" in GCP (mgp-cloud)
# 2) Create Pub/Sub topic, e.g. projects/mgp-cloud/topics/gbp-notifications
# 3) Grant Pub/Sub Publisher to: mybusiness-api-pubsub@system.gserviceaccount.com
# 4) Create a Push subscription to:
#    https://mygoprofile.com/api/google/pubsub?token=<GOOGLE_PUBSUB_VERIFICATION_TOKEN>
# 5) Set the vars below, redeploy, then re-save locations in the dashboard
GOOGLE_PUBSUB_TOPIC=projects/mgp-cloud/topics/gbp-notifications
GOOGLE_PUBSUB_VERIFICATION_TOKEN=generate-a-long-random-string
