rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is the owner of a document.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Users can create, read, and update their own user document.
    // They cannot delete their own user document through the client.
    match /users/{userId} {
      allow create, read, update: if isOwner(userId);
    }
    
    // Subscriptions can only be read by the user who owns them.
    // Writes are handled by the server (Stripe webhook).
    match /subscriptions/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Invites can be created and read by the owner.
    // Team members can claim an invite (update).
    // Invites can be deleted by the owner.
    match /invites/{inviteId} {
      allow read, create, delete: if isOwner(resource.data.ownerId);
      allow update: if request.auth != null; // Allows claiming
    }

    // Waitlist signups from the coming-soon page (server action writes; no auth).
    match /waitlist/{id} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
